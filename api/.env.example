# Copy to api/.env and fill in. api/.env is git-ignored: never commit it.

# SMTP server that sends the email (e.g. your Google Workspace / Microsoft 365
# / hosting provider). Port 587 uses STARTTLS, 465 uses implicit TLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender address: must be a mailbox the SMTP account is allowed to send as,
# or the provider will reject it (or it will land in spam).
MAIL_FROM="TRAMA <no-reply@example.org>"

# Where contact-form messages are delivered.
MAIL_TO=contacto@example.org

# Optional: key that signs the "largest number" challenges. If unset, a random
# one is generated at startup. Generate with: openssl rand -hex 32
CHALLENGE_SECRET=
