# Servicio de noticias (news/server.mjs). Copiar a news/.env si hace falta
# cambiar algo; todas tienen un valor por defecto.

# Cada cuántas horas se consultan las fuentes (por defecto 12).
NEWS_INTERVAL_HOURS=12

# Cuántos días se conservan las noticias, contados desde su publicación (por defecto 180).
NEWS_RETENTION_DAYS=180

# La imagen de Docker ya trae NEWS_SCHEDULER=on y NEWS_DATA_DIR=/data.
# En desarrollo local la tarea programada está apagada: se corre a mano con
#   cd news && npm run ingest
# NEWS_SCHEDULER=on
# NEWS_DATA_DIR=./data
